PORT=5000
DATABASE_URL="mysql://root:@localhost:3306/reachquix"

# Firebase Admin (required for custom verification emails)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Platform SMTP for account verification emails (improves inbox delivery vs Firebase default)
VERIFICATION_SMTP_HOST=
VERIFICATION_SMTP_PORT=587
VERIFICATION_SMTP_USER=
VERIFICATION_SMTP_PASS=
VERIFICATION_SMTP_FROM_NAME=ReachQuix
VERIFICATION_SMTP_FROM_EMAIL=
VERIFICATION_SMTP_USE_SSL=false
APP_URL=https://user.reachquix.com
